{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiSkills": false,
  "permissions": {
    "deny": [
      "Read(./*.db)",
      "Read(./*.gpg)",
      "Read(./.env)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/thangphan-dotfiles/claude/hooks/git-secret-guardrail.sh",
            "if": "Bash(git commit *)",
            "timeout": 10,
            "statusMessage": "Scanning staged changes for secrets..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/thangphan-dotfiles/claude/hooks/enforce-pnpm.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowUnixSockets": [
        "~/.orbstack/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.config/gh",
        "~/.gnupg",
        "~/.password-store",
        "~/.ssh",
        "~/Library/Keychains"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "git:*",
      "pnpm:*"
    ]
  },
  "modelSettings": {
    "claude-opus-4-7": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light"
}
